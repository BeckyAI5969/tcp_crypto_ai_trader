# =========================
# TCP Crypto AI Trader
# Environment Configuration
# =========================

# Runtime mode
TRADING_MODE=PAPER

# Binance Futures Testnet
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# Timezone
APP_TIMEZONE=Asia/Bangkok

# Daily report schedule
DAILY_REPORT_HOUR=0
DAILY_REPORT_MINUTE=5

# Forward test
INITIAL_CAPITAL=1000
MARGIN_MODE=ISOLATED

# Leverage by symbol
BTCUSDT_LEVERAGE=10
ETHUSDT_LEVERAGE=5
SOLUSDT_LEVERAGE=5
XRPUSDT_LEVERAGE=5
BNBUSDT_LEVERAGE=5

# Portfolio risk limits
BASE_RISK_PER_TRADE=0.01
MAX_RISK_PER_TRADE=0.0125
MAX_DAILY_LOSS_PCT=0.03
MAX_COMBINED_OPEN_RISK_PCT=0.025
MAX_MARGIN_USAGE_PCT=0.60
MINIMUM_CASH_RESERVE_PCT=0.40
MAX_OPEN_POSITIONS=3

# Strategy timeframes
SIGNAL_TIMEFRAME=15m
CONFIRMATION_TIMEFRAME=5m
ENTRY_TIMEFRAME=1m

# Logging
LOG_DIR=logs
LOG_LEVEL=INFO
